generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  lastSyncedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissions     Submission[]
  syncCheckpoint  SyncCheckpoint?
  revisionRecords RevisionRecord[]
}

model Problem {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  title       String
  difficulty  String
  solvedAt    DateTime?
  topics      String[]
  submissions Submission[]
}

model Submission {
  id          String   @id // LeetCode submission ID (unique identifier)
  userId      Int
  problemId   Int
  status      String   // e.g. "Accepted", "Wrong Answer", "Time Limit Exceeded"
  language    String?  // e.g. "python3", "cpp", "java"
  runtime     Int?     // milliseconds
  memory      Float?   // megabytes
  submittedAt DateTime // timestamp when the submission was made
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
  @@index([userId, problemId, submittedAt])
  @@index([problemId, status])
}

model SyncCheckpoint {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  isInitialSyncComplete Boolean   @default(false)
  newestSubmissionId    String?
  newestSubmissionTime  DateTime?
  oldestSubmissionId    String?
  oldestSubmissionTime  DateTime?
  lastPersistedOffset   Int       @default(0)
  totalSyncedCount      Int       @default(0)
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevisionRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  topic       String
  problemSlug String?
  outcome     String   // "INDEPENDENT" | "WITH_HINTS" | "COULD_NOT_SOLVE"
  verified    Boolean  @default(false)
  notes       String?
  revisedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic])
  @@index([userId, revisedAt])
}
