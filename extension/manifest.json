{
  "manifest_version": 3,
  "name": "CodeRecall — LeetCode Sync",
  "version": "1.0.0",
  "description": "1-Click historical LeetCode submission synchronizer for the CodeRecall DSA skill assessment platform.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://your-project.vercel.app/*"
]
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeRecall Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
